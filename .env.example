# Public backend URL. Telegram and WhatsApp must reach this over HTTPS.
PORT=8080
NODE_ENV=development
WEB_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080
MERCHANT_HTTP_TIMEOUT_MS=12000
MERCHANT_BROWSER_TIMEOUT_MS=20000
MERCHANT_BROWSER_AUTOMATION_ENABLED=false
MERCHANT_USER_AGENT=CartPilotBot/1.0 (+https://cartpilot.local)
SEARCH_DEBUG_WRITE_ENABLED=false
SEARCH_DEBUG_DIR=debug/search
MERCHANT_SEARCH_MODE=live
MERCHANTS_ENABLED=jumia,konga,jiji,temu
PLAYWRIGHT_EXECUTABLE_PATH=
JUMIA_SEARCH_BASE_URL=https://www.jumia.com.ng/catalog/
KONGA_SEARCH_BASE_URL=https://www.konga.com/search
JIJI_SEARCH_BASE_URL=https://jiji.ng/search
TEMU_SEARCH_BASE_URL=https://www.temu.com/search_result.html

# Internal admin and deep-link signing.
ADMIN_API_TOKEN=change-me
JWT_SECRET=change-me

# WhatsApp Cloud API.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram Bot API.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
LOCAL_BACKEND_URL=http://localhost:8080

# Infrastructure.
REDIS_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cartpilot

# 0G AI provider.
ZERO_G_PRIVATE_KEY=
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_PROVIDER_ADDRESS=0x8e60d466FD16798Bec4868aa4CE38586D5590049
