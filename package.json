{
  "name": "@cartpilot/backend",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "zero-g:test": "tsx src/scripts/zero-g-smoke.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "telegram:bot:me": "node scripts/telegram-get-me.mjs",
    "telegram:poll:local": "node scripts/telegram-poll-local.mjs",
    "telegram:webhook:set": "node scripts/telegram-set-webhook.mjs",
    "telegram:webhook:info": "node scripts/telegram-get-webhook-info.mjs",
    "telegram:webhook:delete": "node scripts/telegram-delete-webhook.mjs",
    "whatsapp:config:check": "node scripts/whatsapp-check-config.mjs"
  },
  "dependencies": {
    "@0glabs/0g-serving-broker": "0.6.2",
    "@prisma/client": "^6.6.0",
    "bullmq": "^5.58.5",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.104.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.12",
    "prisma": "^6.6.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
